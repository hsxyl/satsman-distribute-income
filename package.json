{
  "name": "satsman-auto-distribute-income",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "server:dev": "NEAR_ENV=testnet ts-node src/index.ts",
    "server:start": "cd ./dist && NEAR_ENV=testnet node dist/index.js",
    "server:start:testnet": "NEAR_ENV=testnet node dist/index.js",
    "server:start:staging": "NEAR_ENV=staging node dist/index.js",
    "server:start:production": "NEAR_ENV=production node dist/index.js",
    "dev": "NEAR_ENV=testnet ts-node src/main.ts",
    "start": "cd ./dist && NEAR_ENV=testnet node dist/main.js",
    "start:testnet": "NEAR_ENV=testnet node dist/main.js",
    "start:staging": "NEAR_ENV=staging node dist/main.js",
    "start:production": "NEAR_ENV=production node dist/main.js",
    "lint": "eslint --fix",
    "build": "tsc",
    "prestart": "npm run build"
  },
  "dependencies": {
     "@omnity/ree-client-ts-sdk": "^0.4.8",
    "bitcoinjs-lib": "^7.0.0",
    "dotenv": "^17.2.3",
    "ecpair": "^3.0.0",
    "tiny-secp256k1": "^2.2.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.13",
    "@types/express-session": "^1.17.4",
    "@typescript-eslint/eslint-plugin": "^5.38.0",
    "@typescript-eslint/parser": "^5.38.0",
    "prettier": "^2.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^4.7.4"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "printWidth": 120
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
